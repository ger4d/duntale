$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 560, Height: 430);

  #Title {
    Group {
      $C.@Title { @Text = "Dungeon Portal"; }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 22, Top: 12, Bottom: 18);

    Label #PromptLine1 {
      Anchor: (Height: 22, Bottom: 4);
      Text: "You are about to enter a dungeon.";
      Style: (FontSize: 15, TextColor: #ffffff, Alignment: Center);
    }

    Label #PromptLine2 {
      Anchor: (Height: 20, Bottom: 10);
      Text: "Start a fresh floor-1 run from the Village portal?";
      Style: (FontSize: 13, TextColor: #96a9be, Alignment: Center);
    }

    Label #StateText {
      Anchor: (Width: 240, Height: 34, Bottom: 14);
      Text: "No active dungeon run";
      Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
      Padding: (Horizontal: 12);
      Style: (FontSize: 13, TextColor: #ffe08d, Alignment: Center, RenderBold: true, VerticalAlignment: Center);
      MaskTexturePath: $C.@TextHighlightGradientMask;
    }

    $C.@PanelSeparatorFancy { @Anchor = (Bottom: 14); }

    Group #NoInstanceActions {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 18, Bottom: 18);
      Anchor: (Bottom: 12);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "START NEW RUN";
            Style: (FontSize: 13, TextColor: #E8A93B, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Label {
        Anchor: (Height: 18, Bottom: 10);
        Text: "Begin a fresh floor-1 dungeon run from the portal.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      $C.@TextButton #EnterButton {
        Anchor: (Width: 240, Height: 40);
        Text: "Enter";
      }
    }

    Group #ExistingInstanceActions {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 16, Bottom: 16);
      Anchor: (Bottom: 12);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "RESUME OR RESET";
            Style: (FontSize: 13, TextColor: #ffb56b, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Label {
        Anchor: (Height: 18, Bottom: 10);
        Text: "Continue where you left off, or start over from floor 1.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      $C.@TextButton #ContinueButton {
        Anchor: (Width: 240, Height: 40, Bottom: 10);
        Text: "Continue";
      }

      $C.@CancelTextButton #NewDungeonButton {
        Anchor: (Width: 240, Height: 40);
        Text: "New Dungeon";
      }
    }

    $C.@SecondaryTextButton #CancelButton {
      Anchor: (Width: 220, Height: 40);
      Text: "Cancel";
    }
  }
}