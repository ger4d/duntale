$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 560, Height: 470);

  #Title {
    Group {
      $C.@Title { @Text = "Choose Your Destination"; }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 22, Top: 12, Bottom: 18);

    Label {
      Anchor: (Height: 22, Bottom: 4);
      Text: "A saved dungeon floor is ready to continue.";
      Style: (FontSize: 15, TextColor: #ffffff, Alignment: Center);
    }

    Label {
      Anchor: (Height: 18, Bottom: 14);
      Text: "Resume it now, or return to the village.";
      Style: (FontSize: 13, TextColor: #96a9be, Alignment: Center);
    }

    $C.@PanelSeparatorFancy { @Anchor = (Bottom: 14); }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 14, Bottom: 14);
      Anchor: (Bottom: 12);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "CONTINUE RUN";
            Style: (FontSize: 13, TextColor: #E8A93B, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Label {
        Anchor: (Height: 18, Bottom: 10);
        Text: "Resume your current dungeon floor.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      $C.@TextButton #ContinueButton {
        Anchor: (Width: 220, Height: 40);
        Text: "Continue";
      }
    }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 14, Bottom: 14);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "RETURN TO VILLAGE";
            Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Label {
        Anchor: (Height: 18, Bottom: 10);
        Text: "Return to the village.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      $C.@SecondaryTextButton #VillageButton {
        Anchor: (Width: 220, Height: 40);
        Text: "Village";
      }
    }
  }
}
