$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 560, Height: 400);

  #Title {
    Group {
      $C.@Title { @Text = "Choose Your Destination"; }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 24, Top: 10, Bottom: 18);

    Label {
      Anchor: (Height: 22, Bottom: 4);
      Text: "A saved dungeon floor is ready to continue.";
      Style: (FontSize: 15, TextColor: #ffffff, Alignment: Center);
    }

    Label {
      Anchor: (Height: 18, Bottom: 14);
      Text: "Resume it now, or return to the village.";
      Style: (FontSize: 13, TextColor: #96a9be, Alignment: Center);
    }

    Group {
      Anchor: (Height: 1, Bottom: 14);
      Background: #ffffff(0.12);
    }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 14, Bottom: 14);
      Anchor: (Bottom: 12);

      Label {
        Anchor: (Height: 22, Bottom: 6);
        Text: "Continue";
        Style: (FontSize: 16, TextColor: #FFD700, RenderBold: true, Alignment: Center);
      }

      Label {
        Anchor: (Height: 18, Bottom: 10);
        Text: "Resume your current dungeon floor.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      $C.@TextButton #ContinueButton {
        Anchor: (Width: 220, Height: 40);
        Text: "Continue";
      }
    }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 14, Bottom: 14);

      Label {
        Anchor: (Height: 22, Bottom: 6);
        Text: "Village";
        Style: (FontSize: 16, TextColor: #55FF55, RenderBold: true, Alignment: Center);
      }

      Label {
        Anchor: (Height: 18, Bottom: 10);
        Text: "Return to the village.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      $C.@TextButton #VillageButton {
        Anchor: (Width: 220, Height: 40);
        Text: "Village";
      }
    }
  }
}
