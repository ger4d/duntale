$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 620, Height: 440, Top: 250);

  #Title {
    Group {
      $C.@Title { @Text = "Create Your Companion"; }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 24, Top: 10, Bottom: 20);

    Label {
      Anchor: (Height: 22, Bottom: 4);
      Text: "Choose your Wolf companion's name to finish setup.";
      Style: (FontSize: 15, TextColor: #ffffff, Alignment: Center);
    }

    Label {
      Anchor: (Height: 18, Bottom: 16);
      Text: "Only the Wolf companion is available currently";
      Style: (FontSize: 13, TextColor: #96a9be, Alignment: Center);
    }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 16, Bottom: 16);
      Anchor: (Bottom: 12);

      Label {
        Anchor: (Height: 20, Bottom: 8);
        Text: "Companion Name";
        Style: (FontSize: 14, TextColor: #96a9be, Alignment: Center);
      }

      $C.@TextField #CompanionName {
        @Anchor = (Height: 42);
        PlaceholderText: "Enter a name";
      }
    }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 16, Bottom: 16);
      Anchor: (Bottom: 18);

      Label {
        Anchor: (Height: 20, Bottom: 8);
        Text: "Companion";
        Style: (FontSize: 14, TextColor: #96a9be, Alignment: Center);
      }

      Label #WolfModelButton {
        Anchor: (Height: 40);
        Text: "Wolf";
        Background: #182432;
        Padding: (Horizontal: 14);
        Style: (FontSize: 16, TextColor: #6f7f91, Alignment: Center, RenderBold: true);
      }
    }

    $C.@TextButton #ConfirmButton {
      Anchor: (Width: 240, Height: 42);
      Text: "Confirm Companion";
    }
  }
}