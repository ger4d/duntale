$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 620, Height: 710);

  #Title {
    Group {
      $C.@Title { @Text = "Dungeon Death"; }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 22, Top: 10, Bottom: 18);

    Label #DeathReason {
      Anchor: (Height: 42, Bottom: 6);
      Text: "You died in the dungeon.";
      Style: (FontSize: 15, TextColor: #ffffff, Alignment: Center, VerticalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 11);
    }

    Label {
      Anchor: (Height: 18, Bottom: 12);
      Text: "Choose whether to recover this run, fall back, or leave safely.";
      Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
    }

    Group {
      LayoutMode: Left;
      Anchor: (Height: 44, Bottom: 14);

      Label #FloorText {
        Anchor: (Width: 276, Height: 40, Right: 12);
        Text: "Floor 1";
        Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
        Padding: (Horizontal: 12);
        Style: (FontSize: 16, TextColor: #a9d7ff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
      }

      Label #BalanceText {
        Anchor: (Width: 276, Height: 40);
        Text: "0 gold";
        Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
        Padding: (Horizontal: 12);
        Style: (FontSize: 16, TextColor: #ffe08d, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
        MaskTexturePath: $C.@TextHighlightGradientMask;
      }
    }

    $C.@PanelSeparatorFancy { @Anchor = (Bottom: 14); }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 12, Bottom: 12);
      Anchor: (Bottom: 10);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 6);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "CURRENT FLOOR";
            Style: (FontSize: 13, TextColor: #E8A93B, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Label {
        Anchor: (Height: 18, Bottom: 6);
        Text: "Respawn on this floor.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      Label #CurrentCostText {
        Anchor: (Width: 140, Height: 32, Bottom: 10);
        Text: "500 gold";
        Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
        Padding: (Horizontal: 10);
        Style: (FontSize: 13, TextColor: #ffe08d, Alignment: Center, RenderBold: true, VerticalAlignment: Center);
      }

      $C.@TextButton #CurrentFloorButton {
        Anchor: (Width: 260, Height: 40);
        Text: "Respawn";
      }
    }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 12, Bottom: 12);
      Anchor: (Bottom: 10);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 6);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "LOWER FLOOR";
            Style: (FontSize: 13, TextColor: #ff9d82, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Label #LowerFloorText {
        Anchor: (Height: 20, Bottom: 4);
        Text: "Restart on Floor 1";
        Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center);
      }

      Label {
        Anchor: (Height: 18, Bottom: 6);
        Text: "Abandon this run and start one floor lower.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      Label #LowerCostText {
        Anchor: (Width: 140, Height: 32, Bottom: 10);
        Text: "300 gold";
        Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
        Padding: (Horizontal: 10);
        Style: (FontSize: 13, TextColor: #ffcfbf, Alignment: Center, RenderBold: true, VerticalAlignment: Center);
      }

      $C.@CancelTextButton #LowerFloorButton {
        Anchor: (Width: 260, Height: 40);
        Text: "Lower Floor";
      }
    }

    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 18, Top: 12, Bottom: 12);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 6);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "RETURN TO VILLAGE";
            Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Label {
        Anchor: (Height: 18, Bottom: 8);
        Text: "Return safely for free.";
        Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
      }

      $C.@SecondaryTextButton #VillageButton {
        Anchor: (Width: 260, Height: 40);
        Text: "Village";
      }
    }
  }
}