$C = "../../Common.ui";
$PackBrowser = "../AssetPackSaveBrowser.ui";
$W = "ThemeWidgets.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1320, Height: 820);

  #Title {
    Group {
      $C.@Title { @Text = "Theme Config"; }
    }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Horizontal: 16, Bottom: 20, Top: 4);

    Group #FormPane {
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Anchor: (Width: 840, Right: 14);
      Padding: (Horizontal: 4, Bottom: 4, Top: 0);

      // == HEADER ========================================================
      Group {
        LayoutMode: Top;
        Anchor: (Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 38, Bottom: 6);
          Padding: (Horizontal: 6);

          Label {
            Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center);
            Anchor: (Width: 90);
            Text: "Theme ID";
          }
          $C.@TextField #ThemeIdInput {
            @Anchor = (Width: 240, Right: 16);
            Value: "";
          }
          Label #OverrideNotice {
            Style: (FontSize: 13, TextColor: #FFAA00, VerticalAlignment: Center, Wrap: true);
            Text: "";
            FlexWeight: 1;
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Padding: (Horizontal: 6);

          Group #SelectedPackBox {
            Anchor: (Height: 44, Right: 8);
            Background: $C.@InputBoxBackground;
            Padding: (Horizontal: 10);
            FlexWeight: 1;
            Label #SelectedPackLabel {
              Style: (FontSize: 12, TextColor: #FFFFFF, VerticalAlignment: Center);
              Text: "No asset pack selected";
            }
          }
          $C.@SecondaryTextButton #BrowsePackButton {
            @Anchor = (Width: 160);
            Text: "Browse Packs";
          }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 22);
          Padding: (Horizontal: 6);
          Label #PackStatusLabel {
            Style: (FontSize: 12, TextColor: #55FFFF, VerticalAlignment: Center);
            Text: "Select a writable pack downstream of DungeonGen to save themes.";
          }
        }
      }

      // == IDENTITY ======================================================
      Group {
        LayoutMode: Top;
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        Anchor: (Bottom: 12);
        Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Identity"; } }
        Group {
          LayoutMode: Top;
          Padding: (Horizontal: 14, Top: 4, Bottom: 12);

          Group {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 4);
            Label { Text: "Spawner Prefix"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 130); }
            $C.@TextField #SpawnerPrefix { @Anchor = (Width: 260); Value: "Zone1_Undead"; }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 40, Bottom: 4);
            Label { Text: "Fill Block"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 130); }
            ItemGrid #FieldFillSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #FieldFill { @Anchor = (Width: 270); Text: "Rock_Stone_Brick"; }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Secondary Wall %"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 130); }
            $C.@FloatSlider #SecondaryWallChance { @Anchor = (Width: 280, Right: 30); Min: 0.0; Max: 1.0; Value: 0.2; Step: 0.01; }
          }
          Group {
            LayoutMode: Left;
            Anchor: (Height: 44);
            Label { Text: "Level Variance"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 130); }
            $C.@NumberField #LevelVariance { @Anchor = (Width: 80); Value: 5; Format: (MaxDecimalPlaces: 0, Step: 1, MinValue: 0, MaxValue: 60); }
          }
        }
      }

      // == PALETTE =======================================================
      Group {
        LayoutMode: Top;
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        Anchor: (Bottom: 12);
        Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Palette"; } }
        Group {
          LayoutMode: Top;
          Padding: (Horizontal: 14, Top: 4, Bottom: 12);

          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Primary Wall"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PalettePrimaryWallSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PalettePrimaryWall { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Secondary Wall"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteSecondaryWallSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteSecondaryWall { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Floor"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteFloorSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteFloor { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Ceiling"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteCeilingSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteCeiling { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Pillar Base"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PalettePillarBaseSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PalettePillarBase { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Pillar Middle"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PalettePillarMiddleSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PalettePillarMiddle { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Stairs"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteStairsSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteStairs { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Slab"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteSlabSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteSlab { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Fluid"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteFluidBlockSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteFluidBlock { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Secondary Fluid"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteSecondaryFluidBlockSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteSecondaryFluidBlock { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 8);
            Label { Text: "Accent"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #PaletteAccentBlockSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #PaletteAccentBlock { @Anchor = (Width: 250); Text: ""; }
          }

          // Decay variants
          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Decay Variants"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddDecay { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #DecayList { LayoutMode: Top; Anchor: (Bottom: 8); }

          // Rubble blocks
          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Rubble Blocks"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddRubble { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #RubbleList { LayoutMode: Top; Anchor: (Bottom: 8); }

          // Overgrowth (floor / wall / ceiling)
          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Overgrowth - Floor"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddOgFloor { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #OgFloorList { LayoutMode: Top; Anchor: (Bottom: 8); }

          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Overgrowth - Wall"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddOgWall { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #OgWallList { LayoutMode: Top; Anchor: (Bottom: 8); }

          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Overgrowth - Ceiling"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddOgCeiling { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #OgCeilingList { LayoutMode: Top; }
        }
      }

      // == LIGHTS ========================================================
      Group {
        LayoutMode: Top;
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        Anchor: (Bottom: 12);
        Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Lights"; } }
        Group {
          LayoutMode: Top;
          Padding: (Horizontal: 14, Top: 4, Bottom: 12);
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Wall Light"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #LightsWallLightSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #LightsWallLight { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Ceiling Light"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #LightsCeilingLightSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #LightsCeilingLight { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Floor Light"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #LightsFloorLightBlockSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #LightsFloorLightBlock { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 44, Bottom: 4);
            Label { Text: "Accent Floor Light"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 140); }
            ItemGrid #LightsAccentFloorLightSlot { Anchor: (Width: 34, Height: 34, Right: 8); SlotsPerRow: 1; Style: (SlotSize: 34, SlotIconSize: 34, SlotSpacing: 0, SlotBackground: "../../Common/BlockSelectorSlotBackground.png"); }
            $C.@SecondaryTextButton #LightsAccentFloorLight { @Anchor = (Width: 250); Text: ""; }
          }
          Group { LayoutMode: Left; Anchor: (Height: 34);
            $C.@CheckBoxWithLabel #FloorLightTall { @Text = "Tall Floor Light"; @Checked = false; }
          }
        }
      }

      // == PROPS =========================================================
      Group {
        LayoutMode: Top;
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        Anchor: (Bottom: 12);
        Group { LayoutMode: Left; Anchor: (Height: 36, Bottom: 4);
          Group { Anchor: (Width: 300); $C.@PanelTitle { @Text = "Props"; } }
          Group { FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #AddProp { @Anchor = (Width: 110); Text: "+ Add Prop"; }
        }
        Group #PropList { LayoutMode: Top; Padding: (Horizontal: 10, Top: 2, Bottom: 10); }
      }

      // == TRAPS =========================================================
      Group {
        LayoutMode: Top;
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        Anchor: (Bottom: 12);
        Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Traps"; } }
        Group {
          LayoutMode: Top;
          Padding: (Horizontal: 14, Top: 4, Bottom: 12);
          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Regular Traps"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddTrapRegular { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #TrapRegularList { LayoutMode: Top; Anchor: (Bottom: 8); }

          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Wall Spike Traps"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddTrapWallSpike { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #TrapWallSpikeList { LayoutMode: Top; Anchor: (Bottom: 8); }

          Group { LayoutMode: Left; Anchor: (Height: 32, Bottom: 10);
            Label { Text: "Floor Traps"; Style: (FontSize: 13, TextColor: #afc2c3, RenderBold: true, VerticalAlignment: Center); Anchor: (Width: 200); }
            $C.@SmallSecondaryTextButton #AddTrapFloor { @Anchor = (Width: 90); Text: "+ Add"; }
          }
          Group #TrapFloorList { LayoutMode: Top; }
        }
      }

      // == SPAWN POOL ====================================================
      Group {
        LayoutMode: Top;
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
        Anchor: (Bottom: 12);
        Group { LayoutMode: Left; Anchor: (Height: 36, Bottom: 4);
          Group { Anchor: (Width: 300); $C.@PanelTitle { @Text = "Spawn Pool"; } }
          Group { FlexWeight: 1; }
          $C.@SmallSecondaryTextButton #AddSpawn { @Anchor = (Width: 130); Text: "+ Add Spawn"; }
        }
        Group #SpawnList { LayoutMode: Top; Padding: (Horizontal: 10, Top: 2, Bottom: 10); }
      }

      // == STATUS + BUTTONS ==============================================
      Group {
        LayoutMode: Left;
        Anchor: (Top: 6, Bottom: 12, Height: 24);
        Group { Anchor: (Width: 0); FlexWeight: 1; }
        Label #StatusLabel {
          Style: (FontSize: 13, TextColor: #55FF55, VerticalAlignment: Center);
          Text: "";
          Visible: false;
        }
        Group { Anchor: (Width: 0); FlexWeight: 1; }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Bottom: 4);
        $C.@TextButton #SaveButton { Anchor: (Width: 200, Height: 44, Right: 20); Text: "Save"; }
        $C.@CancelTextButton #DeleteButton { Anchor: (Width: 200, Height: 44, Right: 20); Text: "Delete Override"; Visible: false; }
        $C.@TextButton #ResetButton { Anchor: (Width: 160, Height: 44); Text: "Reset"; }
      }
    }

    Group #PreviewPanel {
      LayoutMode: Top;
      Anchor: (Width: 440);
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Padding: (Horizontal: 12, Top: 10, Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 8); $C.@PanelTitle { @Text = "Preview"; } }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 10);
        Label { Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 78, Right: 8); Text: "Floor"; }
        $W.@SizedDropdownBox #PreviewFloor { @Width = 220; Value: "1"; DropdownEntry { Value: "1"; Text: "Floor 1"; } }
      }

      Group #PreviewViewport {
        LayoutMode: Full;
        Anchor: (Height: 486, Bottom: 10);
        Background: #05070a(0.55);
        PrefabPreviewComponent #PrefabPreview {
          AllowDragYaw: true;
          AllowDragPitch: true;
          AllowZoom: true;
          AllowPan: true;
          ShowAnchor: true;
        }
      }

      Label #PreviewStatusLabel {
        Anchor: (Height: 28, Bottom: 6);
        Style: (FontSize: 13, TextColor: #55FF55, VerticalAlignment: Center, Wrap: true);
        Text: "Generating preview...";
      }
      Label {
        Anchor: (Height: 42);
        Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center, Wrap: true);
        Text: "Edits auto-preview using the selected floor's layout.";
      }
    }
  }
}

// == SEED SELECT OVERLAY =============================================
$C.@PageOverlay #SeedSelectOverlay {
  LayoutMode: Middle;
  Visible: false;
  $C.@DecoratedContainer {
    Anchor: (Width: 560);
    #Title { $C.@Title { @Text = "New / Edit Theme"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);
      Label {
        Anchor: (Bottom: 16, Horizontal: 8);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, Wrap: true, FontSize: 15);
        Text: "Start from blank defaults, or open an existing theme to edit it in place.";
      }
      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 14);
        Label { Text: "Open existing"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 110); }
        $W.@SizedDropdownBox #SeedThemeSelect { @Width = 280; Value: ""; DropdownEntry { Value: ""; Text: "(none)"; } }
      }
      Group {
        LayoutMode: Center;
        Anchor: (Top: 8);
        $C.@TextButton #SeedBlankButton { @Anchor = (Width: 200, Right: 8); Text: "Start Blank"; }
        $C.@SecondaryTextButton #SeedCloneButton { @Anchor = (Width: 200, Left: 8); Text: "Open Selected"; }
      }
    }
  }
}

// == CONFIRM DIALOG ==================================================
$C.@PageOverlay #ConfirmDialog {
  LayoutMode: Middle;
  Visible: false;
  $C.@DecoratedContainer {
    Anchor: (Width: 560);
    #Title { $C.@Title { @Text = "Confirm Action"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);
      Label #ConfirmDialogTitle {
        Anchor: (Bottom: 12, Horizontal: 8);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, FontSize: 28, TextColor: #ffcc00);
        Text: "Confirm?";
      }
      Label #ConfirmDialogMessage {
        Anchor: (Bottom: 18, Horizontal: 8);
        Style: (...$C.@DefaultLabelStyle, HorizontalAlignment: Center, Wrap: true, FontSize: 15);
        Text: "This action cannot be undone.";
      }
      Group {
        LayoutMode: Center;
        Anchor: (Top: 8);
        $C.@CancelTextButton #ConfirmDialogConfirmButton { @Anchor = (Width: 180, Right: 8); Text: "Confirm"; }
        $C.@SecondaryTextButton #ConfirmDialogCancelButton { @Anchor = (Width: 180, Left: 8); Text: "Cancel"; }
      }
    }
  }
}

// == BLOCK PICKER OVERLAY ============================================
$C.@PageOverlay #BlockPickerOverlay {
  LayoutMode: Middle;
  Visible: false;
  $C.@DecoratedContainer {
    Anchor: (Width: 520, Height: 600);
    #Title { $C.@Title { @Text = "Pick Block"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);
      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);
        $C.@TextField #BlockSearchInput { @Anchor = (Right: 8); FlexWeight: 1; Value: ""; }
      }
      Label #BlockPickerHint {
        Anchor: (Height: 22, Bottom: 6);
        Style: (FontSize: 12, TextColor: #96a9be, Wrap: true);
        Text: "Hover an icon to see its block [ID], or type one and Use Typed Value to accept any block.";
      }
      Group {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        FlexWeight: 1;
        Group #BlockList {
          LayoutMode: LeftCenterWrap;
        }
      }
      Group {
        LayoutMode: Left;
        Anchor: (Top: 8, Height: 40);
        $C.@SecondaryTextButton #BlockUseTypedButton { @Anchor = (Width: 170, Right: 6); Text: "Use Typed Value"; }
        $C.@SecondaryTextButton #BlockClearButton { @Anchor = (Width: 120, Right: 6); Text: "Clear"; }
        $C.@SecondaryTextButton #BlockCancelButton { @Anchor = (Width: 120); Text: "Cancel"; }
      }
    }
  }
}

// == ROLE PICKER OVERLAY =============================================
$C.@PageOverlay #RolePickerOverlay {
  LayoutMode: Middle;
  Visible: false;
  $C.@DecoratedContainer {
    Anchor: (Width: 520, Height: 600);
    #Title { $C.@Title { @Text = "Pick Role"; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);
      Group {
        LayoutMode: Left;
        Anchor: (Height: 38, Bottom: 8);
        $C.@TextField #RoleSearchInput { @Anchor = (Right: 8); FlexWeight: 1; Value: ""; }
      }
      Label {
        Anchor: (Height: 22, Bottom: 6);
        Style: (FontSize: 12, TextColor: #96a9be, Wrap: true);
        Text: "Type a role name and Use Typed Value to accept any role.";
      }
      Group #RoleList {
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        FlexWeight: 1;
      }
      Group {
        LayoutMode: Left;
        Anchor: (Top: 8, Height: 40);
        $C.@SecondaryTextButton #RoleUseTypedButton { @Anchor = (Width: 170, Right: 6); Text: "Use Typed Value"; }
        $C.@SecondaryTextButton #RoleCancelButton { @Anchor = (Width: 120); Text: "Cancel"; }
      }
    }
  }
}

// == PACK BROWSER OVERLAYS ===========================================
$C.@PageOverlay #PackBrowserPage {
  LayoutMode: Middle;
  Visible: false;
  $C.@DecoratedContainer {
    Anchor: (Width: 500, Height: 550);
    #Title { $C.@Title { @Text = %server.customUI.assetPackBrowser.title; } }
    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);
      $PackBrowser.@AssetPackSaveBrowserContent {}
    }
  }
}

$C.@PageOverlay #CreatePackPage {
  LayoutMode: Middle;
  Visible: false;
  $C.@DecoratedContainer {
    Anchor: (Width: 500);
    #Title { $C.@Title { @Text = %server.customUI.assetPackBrowser.create.title; } }
    #Content {
      $PackBrowser.@CreatePackFormContent {}
    }
  }
}

$C.@BackButton {}
