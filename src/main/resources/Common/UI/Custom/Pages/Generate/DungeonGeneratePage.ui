$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 920, Height: 700);

  #Title {
    Group {
      $C.@Title { @Text = "Dungeon Generator"; }
    }
  }

  #Content {
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    Padding: (Horizontal: 20, Bottom: 20, Top: 4);

    // == GENERAL ========================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "General"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Seed"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@TextField #Seed { @Anchor = (Width: 210, Right: 30); PlaceholderText: "random"; }
          Label { Text: "World Name"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 100); }
          $C.@TextField #WorldName { @Anchor = (Width: 210); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Origin X"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 70); }
          $C.@NumberField #OriginX { @Anchor = (Width: 85, Right: 16); Value: 0; }
          Label { Text: "Y"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 22); }
          $C.@NumberField #OriginY { @Anchor = (Width: 85, Right: 16); Value: 0; }
          Label { Text: "Z"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 22); }
          $C.@NumberField #OriginZ { @Anchor = (Width: 85, Right: 30); Value: 0; }
          Label { Text: "Floor Lv"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@NumberField #FloorLevel { @Anchor = (Width: 75); Value: 1; }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34);
          $C.@CheckBoxWithLabel #AssembleCheck { @Text = "Assemble in World"; @Checked = false; Anchor: (Right: 40); }
          $C.@CheckBoxWithLabel #ClearCheck { @Text = "Clear Area"; @Checked = false; }
        }
      }
    }

    // == SIZE ============================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Size"; } }

      Group {
        LayoutMode: Left;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Label { Text: "Width"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
        $C.@NumberField #Width { @Anchor = (Width: 85, Right: 30); Value: 64; }
        Label { Text: "Depth"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
        $C.@NumberField #Depth { @Anchor = (Width: 85, Right: 30); Value: 64; }
        Label { Text: "Height"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
        $C.@NumberField #Height { @Anchor = (Width: 85); Value: 12; }
      }
    }

    // == ROOMS ===========================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Rooms"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Max Rooms"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 90); }
          $C.@NumberField #MaxRooms { @Anchor = (Width: 75, Right: 25); Value: 20; }
          Label { Text: "Density"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@TextField #RoomDensity { @Anchor = (Width: 80, Right: 25); }
          Label { Text: "Complexity"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 90); }
          $C.@TextField #Complexity { @Anchor = (Width: 80); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Min Size"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 70); }
          $C.@NumberField #MinRoomSize { @Anchor = (Width: 65, Right: 20); Value: 4; }
          Label { Text: "Max Size"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 70); }
          $C.@NumberField #MaxRoomSize { @Anchor = (Width: 65, Right: 20); Value: 14; }
          Label { Text: "Shape"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #RoomShape { @Anchor = (Width: 170); PlaceholderText: "rectangular"; }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44);
          Label { Text: "Irregularity"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 90); }
          $C.@TextField #Irregularity { @Anchor = (Width: 80); }
        }
      }
    }

    // == CORRIDORS =======================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Corridors"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Width"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@NumberField #CorridorWidth { @Anchor = (Width: 65, Right: 25); Value: 2; }
          Label { Text: "Branch %"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 75); }
          $C.@TextField #BranchChance { @Anchor = (Width: 80, Right: 25); }
          Label { Text: "Loop %"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@TextField #LoopChance { @Anchor = (Width: 80); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34);
          $C.@CheckBoxWithLabel #WindingCheck { @Text = "Winding Corridors"; @Checked = false; Anchor: (Right: 30); }
          Label { Text: "Factor"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #WindingFactor { @Anchor = (Width: 80); }
        }
      }
    }

    // == FEATURES ========================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Features"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Pillars"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@TextField #PillarFreq { @Anchor = (Width: 80, Right: 20); }
          Label { Text: "Water"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #WaterFreq { @Anchor = (Width: 80, Right: 20); }
          Label { Text: "Lava"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 45); }
          $C.@TextField #LavaFreq { @Anchor = (Width: 80); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44);
          Label { Text: "Traps"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #TrapDensity { @Anchor = (Width: 80, Right: 20); }
          Label { Text: "Secrets"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@TextField #SecretWallChance { @Anchor = (Width: 80, Right: 30); }
          $C.@CheckBoxWithLabel #FloorTrapsCheck { @Text = "Floor Traps"; @Checked = false; }
        }
      }
    }

    // == NAVIGATION ======================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Navigation"; } }

      Group {
        LayoutMode: Left;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Label { Text: "Entrance"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 75); }
        $C.@TextField #EntrancePlacement { @Anchor = (Width: 150, Right: 30); PlaceholderText: "edge"; }
        Label { Text: "Exit Distance"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 100); }
        $C.@TextField #ExitDistance { @Anchor = (Width: 80); }
      }
    }

    // == ENEMIES =========================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Enemies"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Density"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@TextField #EnemyDensity { @Anchor = (Width: 80, Right: 20); }
          Label { Text: "Max/Room"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@NumberField #MaxEnemiesPerRoom { @Anchor = (Width: 65, Right: 20); Value: 5; }
          Label { Text: "Ambush %"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@TextField #AmbushChance { @Anchor = (Width: 80); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34);
          $C.@CheckBoxWithLabel #BossRoomCheck { @Text = "Boss Room"; @Checked = true; }
        }
      }
    }

    // == ARCHITECTURE ====================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Architecture"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Erosion"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@TextField #Erosion { @Anchor = (Width: 80); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 34);
          $C.@CheckBoxWithLabel #RemoveCeilingCheck { @Text = "Remove Ceiling"; @Checked = false; Anchor: (Right: 30); }
          $C.@CheckBoxWithLabel #FlatFloorCheck { @Text = "Flat Floor"; @Checked = true; Anchor: (Right: 30); }
          $C.@CheckBoxWithLabel #SolidFillCheck { @Text = "Solid Fill"; @Checked = true; }
        }
      }
    }

    // == THEME ===========================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Theme"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44, Bottom: 4);
          Label { Text: "Palette"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@TextField #Palette { @Anchor = (Width: 190); PlaceholderText: "crypt"; }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 44);
          Label { Text: "Decay"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #DecayFactor { @Anchor = (Width: 80, Right: 20); }
          Label { Text: "Overgrowth"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 90); }
          $C.@TextField #OvergrowthFactor { @Anchor = (Width: 80, Right: 20); }
          Label { Text: "Flooding"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 70); }
          $C.@TextField #FloodingFactor { @Anchor = (Width: 80); }
        }
      }
    }

    // == PACING ==========================================================
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 12);

      Group { Anchor: (Height: 34, Bottom: 4); $C.@PanelTitle { @Text = "Pacing"; } }

      Group {
        LayoutMode: Left;
        Padding: (Horizontal: 14, Top: 4, Bottom: 12);

        Label { Text: "Breathe Rooms"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 110); }
        $C.@TextField #BreatheRoomFreq { @Anchor = (Width: 80, Right: 30); }
        Label { Text: "Difficulty Ramp"; Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 120); }
        $C.@TextField #DifficultyRamp { @Anchor = (Width: 80); }
      }
    }

    // == STATUS ==========================================================
    Label #StatusLabel {
      Style: (FontSize: 14, TextColor: #7a9cc6, HorizontalAlignment: Center);
      Anchor: (Top: 10, Bottom: 12);
      Text: "";
    }

    // == GENERATE BUTTON =================================================
    Group {
      LayoutMode: Left;
      Anchor: (Bottom: 4);

      $C.@TextButton #GenerateButton {
        Anchor: (Width: 240, Height: 44);
        Text: "Generate Dungeon";
      }
    }
  }
}

$C.@BackButton {}

