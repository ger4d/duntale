$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 880, Height: 660);

  #Title {
    Group {
      $C.@Title { @Text = "Dungeon Generator"; }
    }
  }

  #Content {
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@DefaultScrollbarStyle;
    Padding: (Horizontal: 15, Bottom: 15);

    // ── GENERAL ──────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "General"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Seed"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@TextField #Seed { @Anchor = (Width: 200, Right: 25); PlaceholderText: "random"; }
          Label { Text: "World Name"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 90); }
          $C.@TextField #WorldName { @Anchor = (Width: 200); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Origin X"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@NumberField #OriginX { @Anchor = (Width: 80, Right: 10); Value: 0; }
          Label { Text: "Y"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 20); }
          $C.@NumberField #OriginY { @Anchor = (Width: 80, Right: 10); Value: 0; }
          Label { Text: "Z"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 20); }
          $C.@NumberField #OriginZ { @Anchor = (Width: 80, Right: 25); Value: 0; }
          Label { Text: "Floor Lv"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@NumberField #FloorLevel { @Anchor = (Width: 70); Value: 1; }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 28);
          $C.@CheckBoxWithLabel #AssembleCheck { @Text = "Assemble in World"; @Checked = false; Anchor: (Right: 30); }
          $C.@CheckBoxWithLabel #ClearCheck { @Text = "Clear Area"; @Checked = false; }
        }
      }
    }

    // ── SIZE ─────────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Size"; } }

      Group {
        LayoutMode: Left;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Label { Text: "Width"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
        $C.@NumberField #Width { @Anchor = (Width: 80, Right: 25); Value: 64; }
        Label { Text: "Depth"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
        $C.@NumberField #Depth { @Anchor = (Width: 80, Right: 25); Value: 64; }
        Label { Text: "Height"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
        $C.@NumberField #Height { @Anchor = (Width: 80); Value: 12; }
      }
    }

    // ── ROOMS ────────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Rooms"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Max Rooms"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@NumberField #MaxRooms { @Anchor = (Width: 70, Right: 20); Value: 20; }
          Label { Text: "Density"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@TextField #RoomDensity { @Anchor = (Width: 70, Right: 20); }
          Label { Text: "Complexity"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@TextField #Complexity { @Anchor = (Width: 70); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Min Size"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@NumberField #MinRoomSize { @Anchor = (Width: 60, Right: 15); Value: 4; }
          Label { Text: "Max Size"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@NumberField #MaxRoomSize { @Anchor = (Width: 60, Right: 15); Value: 14; }
          Label { Text: "Shape"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 50); }
          $C.@TextField #RoomShape { @Anchor = (Width: 160); PlaceholderText: "rectangular"; }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Irregularity"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@TextField #Irregularity { @Anchor = (Width: 70); }
        }
      }
    }

    // ── CORRIDORS ────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Corridors"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Width"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@NumberField #CorridorWidth { @Anchor = (Width: 60, Right: 20); Value: 2; }
          Label { Text: "Branch %"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
          $C.@TextField #BranchChance { @Anchor = (Width: 70, Right: 20); }
          Label { Text: "Loop %"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #LoopChance { @Anchor = (Width: 70); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 30);
          $C.@CheckBoxWithLabel #WindingCheck { @Text = "Winding Corridors"; @Checked = false; Anchor: (Right: 20); }
          Label { Text: "Factor"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 50); }
          $C.@TextField #WindingFactor { @Anchor = (Width: 70); }
        }
      }
    }

    // ── FEATURES ─────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Features"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Pillars"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #PillarFreq { @Anchor = (Width: 70, Right: 15); }
          Label { Text: "Water"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 50); }
          $C.@TextField #WaterFreq { @Anchor = (Width: 70, Right: 15); }
          Label { Text: "Lava"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 40); }
          $C.@TextField #LavaFreq { @Anchor = (Width: 70); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Traps"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 50); }
          $C.@TextField #TrapDensity { @Anchor = (Width: 70, Right: 15); }
          Label { Text: "Secrets"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #SecretWallChance { @Anchor = (Width: 70, Right: 20); }
          $C.@CheckBoxWithLabel #FloorTrapsCheck { @Text = "Floor Traps"; @Checked = false; }
        }
      }
    }

    // ── NAVIGATION ───────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Navigation"; } }

      Group {
        LayoutMode: Left;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Label { Text: "Entrance"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 65); }
        $C.@TextField #EntrancePlacement { @Anchor = (Width: 140, Right: 25); PlaceholderText: "edge"; }
        Label { Text: "Exit Distance"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 90); }
        $C.@TextField #ExitDistance { @Anchor = (Width: 70); }
      }
    }

    // ── ENEMIES ──────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Enemies"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Density"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@TextField #EnemyDensity { @Anchor = (Width: 70, Right: 15); }
          Label { Text: "Max/Room"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 70); }
          $C.@NumberField #MaxEnemiesPerRoom { @Anchor = (Width: 60, Right: 15); Value: 5; }
          Label { Text: "Ambush %"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 70); }
          $C.@TextField #AmbushChance { @Anchor = (Width: 70); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 28);
          $C.@CheckBoxWithLabel #BossRoomCheck { @Text = "Boss Room"; @Checked = true; }
        }
      }
    }

    // ── ARCHITECTURE ─────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Architecture"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Erosion"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@TextField #Erosion { @Anchor = (Width: 70); }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 28);
          $C.@CheckBoxWithLabel #RemoveCeilingCheck { @Text = "Remove Ceiling"; @Checked = false; Anchor: (Right: 20); }
          $C.@CheckBoxWithLabel #FlatFloorCheck { @Text = "Flat Floor"; @Checked = true; Anchor: (Right: 20); }
          $C.@CheckBoxWithLabel #SolidFillCheck { @Text = "Solid Fill"; @Checked = true; }
        }
      }
    }

    // ── THEME ────────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Theme"; } }

      Group {
        LayoutMode: Top;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Palette"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 55); }
          $C.@TextField #Palette { @Anchor = (Width: 180); PlaceholderText: "crypt"; }
        }

        Group {
          LayoutMode: Left;
          Anchor: (Height: 40);
          Label { Text: "Decay"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 50); }
          $C.@TextField #DecayFactor { @Anchor = (Width: 70, Right: 15); }
          Label { Text: "Overgrowth"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 80); }
          $C.@TextField #OvergrowthFactor { @Anchor = (Width: 70, Right: 15); }
          Label { Text: "Flooding"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 60); }
          $C.@TextField #FloodingFactor { @Anchor = (Width: 70); }
        }
      }
    }

    // ── PACING ───────────────────────────────────────────────
    Group {
      LayoutMode: Top;
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);
      Anchor: (Bottom: 8);

      Group { Anchor: (Height: 30, Bottom: 2); $C.@PanelTitle { @Text = "Pacing"; } }

      Group {
        LayoutMode: Left;
        Padding: (Horizontal: 10, Top: 2, Bottom: 8);

        Label { Text: "Breathe Rooms"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 100); }
        $C.@TextField #BreatheRoomFreq { @Anchor = (Width: 70, Right: 25); }
        Label { Text: "Difficulty Ramp"; Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center); Anchor: (Width: 110); }
        $C.@TextField #DifficultyRamp { @Anchor = (Width: 70); }
      }
    }

    // ── STATUS ───────────────────────────────────────────────
    Label #StatusLabel {
      Style: (FontSize: 13, TextColor: #7a9cc6, HorizontalAlignment: Center);
      Anchor: (Top: 8, Bottom: 10);
      Text: "";
    }

    // ── GENERATE BUTTON ──────────────────────────────────────
    Group {
      LayoutMode: Left;

      $C.@TextButton #GenerateButton {
        Anchor: (Width: 220, Height: 40);
        Text: "Generate Dungeon";
      }
    }
  }
}

$C.@BackButton {}
