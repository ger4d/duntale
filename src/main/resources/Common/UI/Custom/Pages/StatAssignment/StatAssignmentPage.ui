// StatAssignmentPage.ui — Stat point assignment modal.
// Grouped-panel redesign that keeps the existing stat value and button IDs.

$C = "../../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 660, Height: 590);

  #Title {
    Group {
      $C.@Title { @Text = "Assign Stat Points"; }
    }
  }

  #Content {
    LayoutMode: Top;
    Padding: (Horizontal: 20, Top: 12, Bottom: 18);

    Label {
      Anchor: (Height: 22, Bottom: 4);
      Text: "Build your character by spending unassigned points.";
      Style: (FontSize: 15, TextColor: #ffffff, Alignment: Center);
    }

    Label {
      Anchor: (Height: 18, Bottom: 14);
      Text: "Choose a lane: offense and tempo on the left, survival on the right.";
      Style: (FontSize: 12, TextColor: #96a9be, Alignment: Center);
    }

    $C.@SimpleContainer {
      LayoutMode: Top;
      Padding: (Horizontal: 16, Top: 10, Bottom: 14);
      Anchor: (Bottom: 14);

      Group {
        LayoutMode: Top;
        Anchor: (Height: 30, Bottom: 10);

        Group {
          LayoutMode: Left;
          Anchor: (Height: 16, Bottom: 6);

          Label {
            Text: "POINTS READY";
            Style: (FontSize: 13, TextColor: #E8A93B, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
            MaskTexturePath: $C.@TextHighlightGradientMask;
          }
        }

        $C.@PanelSeparatorFancy {}
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 48);

        Group {
          LayoutMode: Top;
          FlexWeight: 1;
          Anchor: (Right: 14);

          Label {
            Anchor: (Height: 18, Bottom: 2);
            Text: "Spend points one at a time to tune your build.";
            Style: (FontSize: 13, TextColor: #ffffff, VerticalAlignment: Center);
          }

          Label {
            Anchor: (Height: 16);
            Text: "Each click applies a single stat point immediately.";
            Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
          }
        }

        Label #UnassignedValue {
          Text: "0";
          Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
          Padding: (Horizontal: 14);
          Style: (FontSize: 24, TextColor: #E8A93B, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
          MaskTexturePath: $C.@TextHighlightGradientMask;
          Anchor: (Width: 92, Height: 44);
        }
      }
    }

    Group {
      LayoutMode: Left;

      Group {
        LayoutMode: Top;
        Anchor: (Width: 304, Right: 12);

        $C.@SimpleContainer {
          LayoutMode: Top;
          Padding: (Horizontal: 14, Top: 10, Bottom: 12);
          Anchor: (Bottom: 12);

          Group {
            LayoutMode: Top;
            Anchor: (Height: 30, Bottom: 8);

            Group {
              LayoutMode: Left;
              Anchor: (Height: 16, Bottom: 6);

              Label {
                Text: "COMBAT AND TEMPO";
                Style: (FontSize: 13, TextColor: #ffb56b, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                MaskTexturePath: $C.@TextHighlightGradientMask;
              }
            }

            $C.@PanelSeparatorFancy {}
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 46, Bottom: 6);

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Anchor: (Right: 10);

              Label {
                Anchor: (Height: 18, Bottom: 2);
                Text: "Strength";
                Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              }

              Label {
                Anchor: (Height: 16);
                Text: "Increase weapon damage output.";
                Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
              }
            }

            Label #StrValue {
              Text: "0";
              Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
              Padding: (Horizontal: 10);
              Style: (FontSize: 14, TextColor: #ffcf97, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
              Anchor: (Width: 54, Height: 34, Right: 10);
            }

            $C.@SmallSecondaryTextButton #StrAddBtn {
              @Anchor = (Width: 76);
              @Text = "Add";
            }
          }

          $C.@ContentSeparator { @Anchor = (Bottom: 6); }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 46, Bottom: 6);

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Anchor: (Right: 10);

              Label {
                Anchor: (Height: 18, Bottom: 2);
                Text: "Agility";
                Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              }

              Label {
                Anchor: (Height: 16);
                Text: "Shorten your attack cooldown.";
                Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
              }
            }

            Label #AgiValue {
              Text: "0";
              Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
              Padding: (Horizontal: 10);
              Style: (FontSize: 14, TextColor: #ffcf97, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
              Anchor: (Width: 54, Height: 34, Right: 10);
            }

            $C.@SmallSecondaryTextButton #AgiAddBtn {
              @Anchor = (Width: 76);
              @Text = "Add";
            }
          }

          $C.@ContentSeparator { @Anchor = (Bottom: 6); }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 46);

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Anchor: (Right: 10);

              Label {
                Anchor: (Height: 18, Bottom: 2);
                Text: "Speed";
                Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              }

              Label {
                Anchor: (Height: 16);
                Text: "Move faster between fights.";
                Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
              }
            }

            Label #SpdValue {
              Text: "0";
              Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
              Padding: (Horizontal: 10);
              Style: (FontSize: 14, TextColor: #ffcf97, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
              Anchor: (Width: 54, Height: 34, Right: 10);
            }

            $C.@SmallSecondaryTextButton #SpdAddBtn {
              @Anchor = (Width: 76);
              @Text = "Add";
            }
          }
        }

        $C.@SimpleContainer {
          LayoutMode: Top;
          Padding: (Horizontal: 14, Top: 10, Bottom: 12);

          Group {
            LayoutMode: Top;
            Anchor: (Height: 30, Bottom: 8);

            Group {
              LayoutMode: Left;
              Anchor: (Height: 16, Bottom: 6);

              Label {
                Text: "FORTUNE";
                Style: (FontSize: 13, TextColor: #E8A93B, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                MaskTexturePath: $C.@TextHighlightGradientMask;
              }
            }

            $C.@PanelSeparatorFancy {}
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 46);

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Anchor: (Right: 10);

              Label {
                Anchor: (Height: 18, Bottom: 2);
                Text: "Luck";
                Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              }

              Label {
                Anchor: (Height: 16);
                Text: "Improve loot quality and bonus rolls.";
                Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
              }
            }

            Label #LckValue {
              Text: "0";
              Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
              Padding: (Horizontal: 10);
              Style: (FontSize: 14, TextColor: #ffe08d, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
              Anchor: (Width: 54, Height: 34, Right: 10);
            }

            $C.@SmallSecondaryTextButton #LckAddBtn {
              @Anchor = (Width: 76);
              @Text = "Add";
            }
          }
        }
      }

      Group {
        LayoutMode: Top;
        Anchor: (Width: 304);

        $C.@SimpleContainer {
          LayoutMode: Top;
          Padding: (Horizontal: 14, Top: 10, Bottom: 12);

          Group {
            LayoutMode: Top;
            Anchor: (Height: 30, Bottom: 8);

            Group {
              LayoutMode: Left;
              Anchor: (Height: 16, Bottom: 6);

              Label {
                Text: "SURVIVAL";
                Style: (FontSize: 13, TextColor: #7a9cc6, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center);
                MaskTexturePath: $C.@TextHighlightGradientMask;
              }
            }

            $C.@PanelSeparatorFancy {}
          }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 46, Bottom: 6);

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Anchor: (Right: 10);

              Label {
                Anchor: (Height: 18, Bottom: 2);
                Text: "Resistance";
                Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              }

              Label {
                Anchor: (Height: 16);
                Text: "Reduce incoming damage taken.";
                Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
              }
            }

            Label #ResValue {
              Text: "0";
              Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
              Padding: (Horizontal: 10);
              Style: (FontSize: 14, TextColor: #a9d7ff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
              Anchor: (Width: 54, Height: 34, Right: 10);
            }

            $C.@SmallSecondaryTextButton #ResAddBtn {
              @Anchor = (Width: 76);
              @Text = "Add";
            }
          }

          $C.@ContentSeparator { @Anchor = (Bottom: 6); }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 46, Bottom: 6);

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Anchor: (Right: 10);

              Label {
                Anchor: (Height: 18, Bottom: 2);
                Text: "Vitality";
                Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              }

              Label {
                Anchor: (Height: 16);
                Text: "Increase your maximum health.";
                Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
              }
            }

            Label #VitValue {
              Text: "0";
              Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
              Padding: (Horizontal: 10);
              Style: (FontSize: 14, TextColor: #a9d7ff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
              Anchor: (Width: 54, Height: 34, Right: 10);
            }

            $C.@SmallSecondaryTextButton #VitAddBtn {
              @Anchor = (Width: 76);
              @Text = "Add";
            }
          }

          $C.@ContentSeparator { @Anchor = (Bottom: 6); }

          Group {
            LayoutMode: Left;
            Anchor: (Height: 46, Bottom: 6);

            Group {
              LayoutMode: Top;
              FlexWeight: 1;
              Anchor: (Right: 10);

              Label {
                Anchor: (Height: 18, Bottom: 2);
                Text: "Stamina";
                Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
              }

              Label {
                Anchor: (Height: 16);
                Text: "Increase your maximum stamina.";
                Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
              }
            }

            Label #StaValue {
              Text: "0";
              Background: (TexturePath: "../../Common/InputBoxSelected.png", Border: 16);
              Padding: (Horizontal: 10);
              Style: (FontSize: 14, TextColor: #a9d7ff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
              Anchor: (Width: 54, Height: 34, Right: 10);
            }

            $C.@SmallSecondaryTextButton #StaAddBtn {
              @Anchor = (Width: 76);
              @Text = "Add";
            }
          }
        }
      }
    }
  }
}

$C.@BackButton {}
